meta {
  name: GET livez
  type: http
  seq: 1
  tags: [
    health
    http
  ]
}

get {
  url: {{httpUrl}}/livez
  body: none
  auth: inherit
}

vars:pre-request {
  httpUrl: http://localhost:9480
}

tests {
  test("liveness is 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("liveness payload has lastCheck", function () {
    expect(res.body).to.have.property("lastCheck");
  });
}
